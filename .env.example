
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CHAPA PAYMENT GATEWAY (Ethiopian Birr - ETB)
# Get your API keys from https://dashboard.chapa.co
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="chapa_webhook_secret_key"

# RESTAURANT NOTIFICATIONS
# Optional Microsoft Teams Incoming Webhook URL to receive live order cards
TEAMS_WEBHOOK_URL=""
# Restaurant administrator email for order alerts
ADMIN_NOTIFICATION_EMAIL="orders@plenty.restaurant"

# STAFF PORTAL
# The staff portal is only served on this subdomain, e.g. admin.plenty.restaurant
# (locally: http://admin.localhost:3000). The public site returns 404 for every staff API.
STAFF_SUBDOMAIN="admin"
# Must match STAFF_SUBDOMAIN; read by the browser bundle at build time.
VITE_STAFF_SUBDOMAIN="admin"
# Long random string used to sign staff sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# The owner account. On every start this email is ensured to be an active super admin
# with this password. If left empty, a one-time password is printed in the server log
# on first run.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"
# Set when running behind a reverse proxy/load balancer (Cloud Run, Nginx, Cloudflare)
# so the server sees the real hostname and HTTPS. Usually "true" or "1".
TRUST_PROXY=""
