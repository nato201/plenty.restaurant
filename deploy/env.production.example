# Production settings for the Lightsail server. setup.sh copies this to /opt/plenty/.env
# and fills in DATABASE_URL, SESSION_SECRET and CHAPA_WEBHOOK_SECRET. Fill in the rest.
# After any change:  sudo systemctl restart plenty
# (VITE_ values are baked in at build time: after changing one, run sudo /opt/plenty/deploy/update.sh)

# --- Addresses ---
APP_URL="https://chapa.plenty.restaurant"
STAFF_SUBDOMAIN="admin"
VITE_STAFF_SUBDOMAIN="admin"
# Caddy runs on the same server in front of the app
TRUST_PROXY="loopback"

# --- Database (filled in by setup.sh) ---
DATABASE_URL=""

# --- Staff sign-in ---
SESSION_SECRET=""
ADMIN_EMAIL=""
# At least 10 characters
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"

# --- Chapa (live keys start with CHASECK- / CHAPUBK-, test keys with CHASECK_TEST-) ---
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
CHAPA_ENCRYPTION_KEY=""
# Paste this same value into Chapa dashboard -> Settings -> Webhooks -> Secret hash
CHAPA_WEBHOOK_SECRET=""

# --- Customer email (Microsoft 365) ---
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS="orders@plenty.restaurant"
EMAIL_FROM_NAME="Plenty Orders"
EMAIL_REPLY_TO="orders@plenty.restaurant"

# --- Microsoft Teams ---
# Workflow link that sends order cards to the employee who ordered
TEAMS_DM_WORKFLOW_URL=""
# Optional channel webhook for kitchen alerts
TEAMS_WEBHOOK_URL=""
